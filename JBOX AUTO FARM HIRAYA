local function restorePlayer()

    stopRunningAnimation()

    local character = player.Character

    local humanoid =
        character and
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = NORMAL_SPEED
    end
end

--==================================================
-- MAIN PACKAGE LOOP
--==================================================

local function startLoop()

    task.spawn(function()

        while running and not destroyed do

            -- PICKUP
            statusLabel.Text = "STATUS: GOING TO PICKUP"

            if walkTo(pickup) then

                statusLabel.Text = "STATUS: PICKING UP"

                task.wait(0.5)

                if running and not destroyed then
                    interact(pickup)
                end

                task.wait(COOLDOWN)
            end

            if not running or destroyed then
                break
            end

            -- DROP
            statusLabel.Text = "STATUS: GOING TO DROP"

            if walkTo(drop) then

                statusLabel.Text = "STATUS: DROPPING"

                task.wait(0.5)

                if running and not destroyed then
                    interact(drop)
                end

                task.wait(COOLDOWN)
            end
        end

        if not destroyed then
            statusLabel.Text = "STATUS: IDLE"
        end

        restorePlayer()
    end)
end

