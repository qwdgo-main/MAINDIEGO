--==================================================
-- PATH CREATION
--==================================================

local function createPath(root, target)

    local path = PathfindingService:CreatePath({
        AgentRadius = 2,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 5
    })

    local success = pcall(function()

        path:ComputeAsync(
            root.Position,
            target.Position
        )
    end)

    if success and
        path.Status == Enum.PathStatus.Success then

        return path:GetWaypoints()
    end

    return nil
end

--==================================================
-- OPTIMIZED WALK
--==================================================

local function walkTo(target)

    if not running or destroyed then
        return false
    end

    local character =
        player.Character or
        player.CharacterAdded:Wait()

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    local root =
        character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then
        return false
    end

    humanoid.WalkSpeed = WALK_SPEED

    startRunningAnimation(humanoid)

    local waypoints = createPath(root, target)

    --==================================================
    -- FALLBACK MOVEMENT
    --==================================================

    if not waypoints then

        humanoid:MoveTo(target.Position)

        while running and not destroyed do

            humanoid.WalkSpeed = WALK_SPEED

            applyTargetVelocity(root)

            if
                (root.Position - target.Position).Magnitude
                <= 6
            then

                stopRunningAnimation()
                return true
            end

            RunService.Heartbeat:Wait()
        end

        stopRunningAnimation()
        return false
    end

    --==================================================
    -- PATH MOVEMENT
    --==================================================

    local index = 1
    local lastPosition = root.Position
    local stuckTime = 0

    while running and not destroyed do

        humanoid.WalkSpeed = WALK_SPEED

        if
            (root.Position - target.Position).Magnitude
            <= 6
        then

            stopRunningAnimation()
            return true
        end

        local waypoint = waypoints[index]

        if not waypoint then

            humanoid:MoveTo(target.Position)

        else

            if waypoint.Action ==
                Enum.PathWaypointAction.Jump then

                humanoid.Jump = true
            end

            humanoid:MoveTo(waypoint.Position)

            -- Advance before exact waypoint
            if
                (root.Position - waypoint.Position).Magnitude
                <= 8
            then

                index += 1
            end
        end

        applyTargetVelocity(root)

        local moved =
            (root.Position - lastPosition).Magnitude

        if moved < 0.25 then

            stuckTime +=
                RunService.Heartbeat:Wait()

        else

            stuckTime = 0

            RunService.Heartbeat:Wait()
        end

        lastPosition = root.Position

        -- Recalculate path if stuck
        if stuckTime >= 0.75 then

            waypoints = createPath(root, target)

            index = 1
            stuckTime = 0

            if not waypoints then
                humanoid:MoveTo(target.Position)
            end
        end
    end

    stopRunningAnimation()

    return false
end

