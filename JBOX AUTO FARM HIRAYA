--==================================================
-- DRAGGABLE GUI
--==================================================

local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)

    if not dragging then
        return
    end

    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then

        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = false
    end
end)

--==================================================
-- RUNNING ANIMATION
--==================================================

local function stopRunningAnimation()

    if currentRunTrack then
        pcall(function()
            currentRunTrack:Stop(0.1)
            currentRunTrack:Destroy()
        end)

        currentRunTrack = nil
    end

    if currentRunAnimation then
        pcall(function()
            currentRunAnimation:Destroy()
        end)

        currentRunAnimation = nil
    end
end

local function startRunningAnimation(humanoid)

    stopRunningAnimation()

    local animator = humanoid:FindFirstChildOfClass("Animator")

    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://180426354"

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if not success or not track then
        animation:Destroy()
        return
    end

    track.Priority = Enum.AnimationPriority.Movement
    track.Looped = true
    track:Play(0.1)
    track:AdjustSpeed(ANIMATION_SPEED)

    currentRunTrack = track
    currentRunAnimation = animation
end

--==================================================
-- TARGET VELOCITY
--==================================================

local function applyTargetVelocity(root)

    if not root then
        return
    end

    local velocity = root.AssemblyLinearVelocity

    local horizontal = Vector3.new(
        velocity.X,
        0,
        velocity.Z
    )

    if horizontal.Magnitude > 0.1 then

        local direction = horizontal.Unit

        root.AssemblyLinearVelocity = Vector3.new(
            direction.X * TARGET_VELOCITY,
            velocity.Y,
            direction.Z * TARGET_VELOCITY
        )
    end
end

