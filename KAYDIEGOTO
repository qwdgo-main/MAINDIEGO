local WHITELIST_URL = "https://gist.githubusercontent.com/qwdgo-main/d45b8e61e2119a7292d076d820adb34c/raw/whitelist.json"

local function isWhitelisted()
	local success, result = pcall(function()
		return game:HttpGet(WHITELIST_URL .. "?t=" .. tostring(os.time()))
	end)

	if not success or not result then
		warn("[QWDGO] Failed to fetch whitelist")
		return false
	end

	local myId = tostring(LocalPlayer.UserId)

	local ok, data = pcall(function()
		return game:GetService("HttpService"):JSONDecode(result)
	end)

	if ok and type(data) == "table" then
		-- Format: { "whitelist": ["123456", "789"] }
		if data.whitelist and type(data.whitelist) == "table" then
			for _, id in pairs(data.whitelist) do
				if tostring(id) == myId then
					return true
				end
			end
		end

		-- Format: ["123456", "789"]
		for _, id in pairs(data) do
			if type(id) ~= "table" and tostring(id) == myId then
				return true
			end
		end
	else
		-- Plain text (one ID per line)
		for line in string.gmatch(result, "[^\r\n]+") do
			local cleaned = line:match("^%s*(.-)%s*$")
			if cleaned == myId then
				return true
			end
		end
	end

	return false
end

if not isWhitelisted() then
	LocalPlayer:Kick("You are not whitelisted.")
	return
end

